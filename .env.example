NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Generate a unique high-entropy value for every environment. Never commit it.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3000

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
SANITY_API_TOKEN=

# Local PostgreSQL container. Never reuse this password in production.
POSTGRES_DB=comeat
POSTGRES_USER=comeat
POSTGRES_PASSWORD=CHANGE_ME_FOR_LOCAL_DEVELOPMENT
POSTGRES_PORT=5434

# PostgreSQL connection used by Prisma. Keep this aligned with the values above.
DATABASE_URL="postgresql://comeat:CHANGE_ME_FOR_LOCAL_DEVELOPMENT@127.0.0.1:5434/comeat?schema=public"

# Stripe test-mode keys. The publishable key is intentionally browser-visible;
# the secret and webhook keys must remain private server environment variables.
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOK_SECRET=whsec_

RESEND_API_KEY=
AUTH_EMAIL_FROM=
ORDER_NOTIFICATION_EMAIL=

NEXT_PUBLIC_GA_ID=
